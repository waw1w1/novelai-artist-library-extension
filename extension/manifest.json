{
  "manifest_version": 3,
  "name": "NovelAI Prompt Gallery",
  "version": "0.1.0",
  "description": "Manage artist prompts and character tags on NovelAI with a local image gallery that preserves original metadata.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://novelai.net/*",
    "https://*.novelai.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://novelai.net/*"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "src/*.js"
      ],
      "matches": [
        "https://novelai.net/*"
      ]
    }
  ],
  "options_page": "settings.html",
  "action": {
    "default_title": "NovelAI Prompt Gallery Settings"
  }
}
